# ==========================================
# ChurnSentry MVP - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your own values
# DO NOT COMMIT .env to version control!

# ==========================================
# Backend Server Configuration
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# JWT Secret Key (for token signing)
# Generate a strong random string for production
# ==========================================
JWT_SECRET=churn-sentry-secret-token-key-2026

# ==========================================
# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Leave blank or set to "MY_GEMINI_API_KEY" to use rule-based fallbacks
# ==========================================
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==========================================
# Database Configuration
# For development: uses JSON file at /data/db.json
# For production: add PostgreSQL configuration here
# ==========================================
DATABASE_TYPE=json
# DATABASE_URL=postgresql://user:password@localhost:5432/churnpredictor

# ==========================================
# Admin Default Credentials
# Change these immediately after first login in production!
# ==========================================
ADMIN_EMAIL=admin@churnpredictor.com
ADMIN_PASSWORD=admin123

# ==========================================
# ML Model Configuration
# ==========================================
ML_EPOCHS=100
ML_LEARNING_RATE=0.05
ML_DATASET_SIZE=150

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Deployment URLs
# ==========================================
APP_URL=http://localhost:3000
